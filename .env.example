# LLM Inference Logger
# cp .env.example .env

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/llm_logger

# Redis
REDIS_URL=redis://redis:6379

# LLM Provider API Keys (free tiers)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
